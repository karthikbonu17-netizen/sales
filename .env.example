# SalesMind Environment Configuration

# Server Port
PORT=5000
HOST=127.0.0.1

# Database Configuration (Defaults to embedded high-performance SQLite; PostgreSQL can be configured)
DATABASE_URL=
DATABASE_TYPE=sqlite
DB_FILE=salesmind.db

# LLM Provider Configuration (Optional: SalesMind comes with a robust built-in engine if no key is supplied)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hindsight Memory System
HINDSIGHT_STORAGE_PATH=./data/hindsight

# Security & Sessions
JWT_SECRET=salesmind-enterprise-secret-key-prod-9821
CORS_ORIGIN=http://localhost:5173
